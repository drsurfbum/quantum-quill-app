# Use a dedicated database. Never point the alpha initializer at recovered writing.
DATABASE_URL=postgresql://username:password@localhost:5432/quantum_quill_alpha
# Generate a random secret of at least 32 characters; do not commit the real value.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
NODE_ENV=development
HOST=127.0.0.1
PORT=5055
UPLOAD_DIR=./uploads
# Required only for the guarded, empty-database initializer.
QQ_DATABASE_PURPOSE=fresh-alpha
